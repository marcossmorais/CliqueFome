NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Identificação obrigatória antes de publicar /termos como documento definitivo.
# São variáveis de servidor e não ficam expostas em bundles do navegador.
CLIQUEFOME_RAZAO_SOCIAL=
CLIQUEFOME_CNPJ=
CLIQUEFOME_ENDERECO=
CLIQUEFOME_EMAIL_PRIVACIDADE=
CLIQUEFOME_DATA_VIGENCIA=

# Chave secreta do Supabase (client privilegiado). Somente servidor — nunca
# prefixar com NEXT_PUBLIC_. O navegador não recebe essa chave.
#
# Prefira uma `sb_secret_…` do modelo novo de chaves: ela é revogável
# individualmente. A service_role legada (JWT `eyJ…`) só se revoga rotacionando
# o segredo JWT do projeto inteiro, o que derruba todos os ambientes juntos.
SUPABASE_SECRET_KEY=

# Segredo do HMAC que anonimiza IP e telefone nos baldes de rate limit
# (hashLimite, lib/pedidos/servidor.ts). Precisa de 24+ caracteres.
#
# Variável própria de propósito: antes isto reaproveitava a chave do Supabase,
# o que juntava duas funções sem relação na mesma credencial — rotacionar a
# chave do banco zerava todos os limites, e o segredo de hash herdava o
# alcance de uma credencial que ignora RLS. Sem ela o código ainda cai na
# chave do Supabase e loga um aviso, para não quebrar o checkout no ar.
# Gerar com: openssl rand -hex 32
RATE_LIMIT_HMAC_SECRET=

# Geocodifica endereços e calcula rotas de Delivery somente no servidor.
# Nunca prefixar com NEXT_PUBLIC_.
GEOAPIFY_API_KEY=

# Checkout público (app/api/lojas/[slug]/pedidos, lib/pedidos/*). Usa
# SUPABASE_SECRET_KEY como client privilegiado e RATE_LIMIT_HMAC_SECRET como
# pimenta do hash de rate limit — as duas acima.
#
# Kill switch de rollback: "false" desliga a rota sem tocar no banco nem
# reverter deploy (ver bloco ROLLBACK em schema-migracao-checkout-publico.sql).
# Qualquer outro valor (ou ausente) mantém o checkout ligado.
CHECKOUT_PUBLICO_ATIVO=
# Cloudflare Turnstile (opcional). Sem esta chave, a checagem de CAPTCHA é
# pulada — a defesa contra abuso hoje são os limites no banco
# (consumir_cota_checkout). Quando configurar, o site precisa embutir o
# widget do Turnstile e mandar o token em `captchaToken` no POST.
TURNSTILE_SECRET_KEY=

# Observabilidade (instrumentation.ts, lib/observabilidade/logger.ts).
# Nenhuma das duas é obrigatória pra rodar — sem SENTRY_DSN, o Sentry
# simplesmente não inicializa (zero custo, zero chamada de rede).
LOG_LEVEL=
SENTRY_DSN=

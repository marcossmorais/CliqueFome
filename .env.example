NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Identificação obrigatória antes de publicar /termos como documento definitivo.
# São variáveis de servidor e não ficam expostas em bundles do navegador.
CLIQUEFOME_RAZAO_SOCIAL=
CLIQUEFOME_CNPJ=
CLIQUEFOME_ENDERECO=
CLIQUEFOME_EMAIL_PRIVACIDADE=
CLIQUEFOME_DATA_VIGENCIA=

# Delivery facilitado (lib/delivery/*, app/api/delivery/*, app/api/admin/delivery/*).
# Todas de servidor só — nunca prefixar com NEXT_PUBLIC_.
# Client privilegiado usado pra ler/gravar configuracoes_delivery* ignorando RLS.
SUPABASE_SERVICE_ROLE_KEY=
# Geocodificação + rota (só chamada no modo "por km", nunca na taxa fixa
# nem numa cidade vizinha do modo avançado).
GEOAPIFY_API_KEY=
# Segredo do HMAC que assina a cotação devolvida ao cardápio. Se não
# definida, cai para GEOAPIFY_API_KEY — defina a sua própria em produção.
DELIVERY_QUOTE_SECRET=

# Checkout público (app/api/lojas/[slug]/pedidos, lib/pedidos/*). Reaproveita
# SUPABASE_SERVICE_ROLE_KEY acima como client privilegiado e como pimenta do
# hash de rate limit — nenhuma variável nova é obrigatória pra ligar.
#
# Kill switch de rollback: "false" desliga a rota sem tocar no banco nem
# reverter deploy (ver bloco ROLLBACK em schema-migracao-checkout-publico.sql).
# Qualquer outro valor (ou ausente) mantém o checkout ligado.
CHECKOUT_PUBLICO_ATIVO=
# Cloudflare Turnstile (opcional). Sem esta chave, a checagem de CAPTCHA é
# pulada — a defesa contra abuso hoje são os limites no banco
# (consumir_cota_checkout). Quando configurar, o site precisa embutir o
# widget do Turnstile e mandar o token em `captchaToken` no POST.
TURNSTILE_SECRET_KEY=

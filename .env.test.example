# Variáveis pros testes e2e (tests/e2e/*.spec.ts, npm run test:e2e).
# Nunca credencial real — sempre uma conta/loja de teste dedicada.

# Login de dono de loja de teste. Sem isso, tests/e2e/admin-login.spec.ts
# pula (não falha o pipeline).
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Slug da loja de teste usada em tests/e2e/checkout-pix.spec.ts — precisa
# ter WhatsApp cadastrado e pelo menos um produto ativo. Default: lojateste.
E2E_LOJA_SLUG=

# Secrets do CI (Settings > Secrets > Actions), não deste arquivo:
# NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY e E2E_LOJA_SLUG
# já estão configurados. Falta SUPABASE_SERVICE_ROLE_KEY.
#
# Para essa, NÃO use a service_role legada (o JWT eyJ... do projeto): ela não
# é revogável sozinha — revogar significa rotacionar o segredo JWT inteiro e
# derrubar a Vercel junto. Crie no painel da Supabase uma chave `sb_secret_`
# dedicada ao CI. Se um dia vazar, revoga só ela, sem downtime.
#
# checkout-pix.spec.ts cria um pedido de verdade e apaga no final
# (removerPedidoDeTeste), justamente para o CI não deixar rastro na base.

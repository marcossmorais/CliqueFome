# Variáveis pros testes e2e (tests/e2e/*.spec.ts, npm run test:e2e).
# Nunca credencial real — sempre uma conta/loja de teste dedicada.

# Login de dono de loja de teste. Sem isso, tests/e2e/admin-login.spec.ts
# pula (não falha o pipeline).
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Slug da loja de teste usada em tests/e2e/checkout-pix.spec.ts — precisa
# ter WhatsApp cadastrado e pelo menos um produto ativo. Default: lojateste.
E2E_LOJA_SLUG=

# ---------------------------------------------------------------------------
# CI: projeto Supabase de TESTE/STAGING, nunca produção
# ---------------------------------------------------------------------------
# checkout-pix.spec.ts cria um pedido de verdade (e apaga no final, via
# removerPedidoDeTeste). Rodar isso contra produção mexe na base real do
# lojista, então as quatro variáveis abaixo têm de pertencer ao MESMO projeto
# de teste. Hoje o repositório está sem secret nenhum de propósito: o e2e pula
# e o job avisa, em vez de apontar para produção.
#
# Cadastrar em Settings > Secrets and variables > Actions:
#   NEXT_PUBLIC_SUPABASE_URL       url do projeto de teste
#   NEXT_PUBLIC_SUPABASE_ANON_KEY  chave publishable do projeto de teste
#   SUPABASE_SECRET_KEY            sb_secret_… dedicada, do projeto de teste
#   E2E_LOJA_SLUG                  loja semeada nesse projeto
#   RATE_LIMIT_HMAC_SECRET         qualquer segredo de 24+ chars (openssl rand -hex 32)
#
# A SUPABASE_SECRET_KEY deve ser uma `sb_secret_…` do modelo novo, revogável
# individualmente — nunca a service_role legada (JWT `eyJ…`), que só se revoga
# rotacionando o segredo JWT do projeto inteiro.
#
# A chave é lida apenas no processo Node (servidor de teste e a limpeza do
# spec). Nunca com prefixo NEXT_PUBLIC_, nunca no bundle, e o fetch de limpeza
# não passa pelo navegador — logo não entra em trace, vídeo nem screenshot.

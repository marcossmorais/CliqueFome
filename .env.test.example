# Variáveis pros testes e2e (tests/e2e/*.spec.ts, npm run test:e2e).
# Nunca credencial real — sempre uma conta/loja de teste dedicada.

# Login de dono de loja de teste. Sem isso, tests/e2e/admin-login.spec.ts
# pula (não falha o pipeline).
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Slug da loja de teste usada em tests/e2e/checkout-pix.spec.ts — precisa
# ter WhatsApp cadastrado e pelo menos um produto ativo. Default: lojateste.
E2E_LOJA_SLUG=

{
  "name": "cliquefome",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "knip": "knip",
    "test:e2e": "playwright test",
    "pretest": "node -e \"require('fs').mkdirSync('coverage',{recursive:true})\"",
    "test": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"tests/**/*.test.mjs\"",
    "test:ajuda": "node --test tests/ajuda-suporte.test.mjs",
    "test:historico": "node --test tests/historico-pedidos.test.mjs",
    "test:avaliacoes": "node --test tests/avaliacoes.test.mjs",
    "test:checkout": "node --test tests/checkout.test.mjs",
    "test:dashboard": "node --test tests/dashboard.test.mjs",
    "test:cozinha": "node --test tests/cozinha/fluxo.test.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.69.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "@vercel/otel": "^2.1.3",
    "next": "16.3.0",
    "pino": "^10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "knip": "^6.32.0",
    "pino-pretty": "^13.1.3",
    "typescript": "^5"
  }
}
